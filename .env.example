# ==============================================================================
# CONFIGURACIÓN DEL ECOSISTEMA DE ASISTENCIA EMOCIONAL
# ==============================================================================
# Copie este archivo como '.env' y modifique los valores para su entorno local.
# ==============================================================================

# Entorno de ejecución: 'development' o 'production'
APP_ENV=development

# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# SERVICIO OLLAMA (Motor LLM)
# ------------------------------------------------------------------------------
# Host de Ollama. Si usa Docker Compose, cámbielo a 'http://ollama-engine:11434'
OLLAMA_HOST=http://localhost:11434

# Nombre del modelo a usar localmente
OLLAMA_MODEL=qwen2.5:14b

# Tiempo que el modelo permanece en memoria (ej: 10m, 1h, -1 para infinito)
OLLAMA_KEEP_ALIVE=10m

# Habilitar soporte Vulkan para aceleración por GPU (0=Falso, 1=Verdadero)
OLLAMA_VULKAN=1
GGML_VULKAN=1

# ------------------------------------------------------------------------------
# SERVICIO CHROMADB (Base de datos Vectorial)
# ------------------------------------------------------------------------------
# Host de Chroma. Si usa Docker Compose, cámbielo a 'http://chromadb:8000'
CHROMA_HOST=http://localhost:8000

# Ruta persistente de almacenamiento de vectores
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# ------------------------------------------------------------------------------
# BACKEND FASTAPI
# ------------------------------------------------------------------------------
# Puerto del Backend FastAPI
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# SEGURIDAD Y AUDITORÍA
# ------------------------------------------------------------------------------
# Clave secreta para cookies de sesión o JWT (Modifique en producción)
SECRET_KEY=cambiar_este_valor_en_produccion_muy_secreto

# Habilitar el logging estricto de eventos de crisis (True/False)
LOG_CRISIS_EVENTS=True
